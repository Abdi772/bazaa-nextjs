 # Copy this file to .env.local for local work. On Vercel, add each variable
# under Settings -> Environment Variables. Never commit real values.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Site address (used for links, sitemap and share cards) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Cloudflare Turnstile (login/sign-up spam protection) ---
# Public site key. If empty, the check is skipped.
# The Turnstile SECRET key goes only in Supabase (Authentication -> Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Used by account deletion and Telegram routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=a-long-random-string
